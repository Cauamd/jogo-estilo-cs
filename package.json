  },
  "dependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "colyseus.js": "^0.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
